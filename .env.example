# Copy this file to ".env" and fill in real values. Never commit the real .env.

# --- MySQL connection (the ONE shared database for all sites) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=web_hub

# --- HTTP server ---
PORT=4000
# In production this same process also serves the built admin SPA (see
# ADMIN_DIST_PATH) so the admin panel and its API share one origin.
ADMIN_DIST_PATH=../admin/dist

# --- Auth (JWT) ---
# Random long secret used to sign admin login tokens — MUST be a real random
# string in production (there is no insecure fallback, unlike the old sites).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- CORS: comma-separated list of the public sites' origins allowed to call
# this API from the browser (site1/site2/site3, plus future sites). Required
# in production since the API now lives on its own subdomain, separate from
# each public site's static build. Leave empty only for local dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Seed / first admin account (used by `npm run db:create-admin`) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123!
